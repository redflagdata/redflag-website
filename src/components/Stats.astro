---
const { content } = Astro.props;

const { markup } = Astro.props;
---
{markup ? <Fragment set:html={markup} /> : <>

<section class="band"><div class="wrap"><div class="sec-head"><p class="eyebrow">{content.eyebrow}</p><h2>{content.title}</h2></div><div class="stats">{content.items.map((item: any) => <div class="stat"><div class="n">{item.value}</div><p>{item.text}</p></div>)}</div></div></section>

</>}
