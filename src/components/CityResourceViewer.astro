<div class="city-source-viewer" data-city-source-viewer data-active-source="citywide">
  <div class="viewer-topbar">
    <div class="viewer-brand"><b>redflag</b><span>Connected GIS layers, city records, and parcel context</span></div>
  </div>
  <div class="viewer-body">
    <aside class="viewer-sources" aria-label="Linked city source layers">
      <div class="viewer-sources-header viewer-documents-heading">
        <div><span>Cited city records</span><b>4 records</b></div>
      </div>
      <div class="viewer-sources-content">
        <p>Select a source to see its regulation and mapped extent.</p>
        <div class="viewer-layer-list">
          {records.map((record, index) => (
            <button class={`viewer-layer${index === 0 ? ' is-active' : ''}`} type="button" data-source-target={record.id} aria-pressed={index === 0 ? 'true' : 'false'}>
              <span><b>{record.source}</b><small>{record.type}</small><em>{record.scope}</em></span>
            </button>
          ))}
        </div>
      </div>
    </aside>

    <section class="viewer-map" aria-label="Illustrative city GIS map">
      <div class="viewer-map-header"><div><span>GIS context</span><b data-active-source-name>Title 18 - Development Code</b></div><p><i></i>Parcel view</p></div>
      <svg viewBox="0 0 760 530" role="img" aria-label="Illustrative city map with a selected parcel and regulatory boundaries" preserveAspectRatio="xMidYMid slice">
        <rect width="760" height="530" fill="#edf2f3" />
        <path d="M0 419C121 380 211 389 316 415S524 473 760 427V530H0Z" fill="#dcecf1" />
        <path d="M0 420C121 381 211 390 316 416S524 474 760 428" fill="none" stroke="#8ab7c8" stroke-width="5" stroke-linecap="round" />
        <g fill="#f8faf9" stroke="#d5dde1" stroke-width="2"><path d="M44 55H232V152H44z" /><path d="M259 52H456V138H259z" /><path d="M492 50H703V165H492z" /><path d="M45 203H190V331H45z" /><path d="M240 190H440V317H240z" /><path d="M494 222H701V348H494z" /><path d="M60 384H243V411H60z" /><path d="M290 368H470V408H290z" /><path d="M518 386H692V421H518z" /></g>
        <g class="viewer-overlay is-active" data-map-overlay="citywide"><path d="M68 78L207 43L385 65L567 48L684 119L716 242L682 355L611 463L446 490L262 465L112 430L54 304Z" fill="#ef553a" fill-opacity=".06" stroke="#ef553a" stroke-dasharray="7 6" stroke-width="3" /><text x="91" y="88" fill="#d73d25" font-size="14" font-weight="700">CITY LIMITS</text></g>
        <g class="viewer-overlay" data-map-overlay="plan"><path d="M126 106L286 77L456 88L606 143L649 253L593 322L468 365L296 350L175 295L104 212Z" fill="#4f6fff" fill-opacity=".18" stroke="#3157f6" stroke-width="4" /><text x="421" y="122" fill="#1d3ea8" font-size="14" font-weight="700">URBAN CENTER</text></g>
        <g class="viewer-overlay" data-map-overlay="specific"><path d="M278 149L467 147L508 207L485 304L434 345L306 328L249 269L245 210Z" fill="#13c8bd" fill-opacity=".18" stroke="#13c8bd" stroke-width="4" /><text x="328" y="208" fill="#078d84" font-size="14" font-weight="700">MIDTOWN PLAN</text></g>
        <g class="viewer-overlay" data-map-overlay="flood"><path d="M-20 382C103 345 210 350 316 379S530 440 786 389L786 475C589 522 455 486 322 454S111 427-20 468Z" fill="#fff4f1" fill-opacity=".58" stroke="#fd793e" stroke-width="4" /><text x="495" y="463" fill="#b91f13" font-size="14" font-weight="700">DRAINAGE CORRIDOR</text></g>
        <g class="viewer-parcel"><path d="M350 254H420V318H350Z" fill="#ff5a36" fill-opacity=".25" stroke="#ef4325" stroke-width="5" /><circle cx="385" cy="286" r="15" fill="#ef4325" stroke="#fff" stroke-width="5" /><path d="M379 286h12M385 280v12" stroke="#fff" stroke-width="2" stroke-linecap="round" /></g>
