---
import CREProjectCanvas from './CREProjectCanvas.astro';
---

<section class="cre-value-section">
  <main class="width-wrapper width-wrapper-full-width">
    <div class="cre-value-head">
      <p class="cre-value-eyebrow">Value across the development lifecycle</p>
      <h2>One shared source of truth keeps development moving.</h2>
    </div>

    <div class="cre-value-outcome-grid">
      <article class="cre-value-outcome">
        <h3>Acquisition teams</h3>
        <p>Identify market, parcel, and site risk earlier.</p>
      </article>
      <article class="cre-value-outcome">
        <h3>Development teams</h3>
        <p>Manage pre-development and site investigation with clear visibility into zoning, access, utilities, and approvals.</p>
      </article>
      <article class="cre-value-outcome">
        <h3>Portfolio + executive teams</h3>
        <p>See risk, velocity, and where intervention is needed across every market and project.</p>
      </article>
      <article class="cre-value-outcome">
        <h3>IT + document control teams</h3>
        <p>Keep plans, source documents, versions, and updates organized so every team can act on the latest record.</p>
      </article>
    </div>

    <div class="cre-value-diagram">
      <CREProjectCanvas />
    </div>
  </main>
</section>
