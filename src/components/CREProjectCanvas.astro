---
const context = [
  { icon: '§', label: 'Zoning rules', detail: 'Use, height, setbacks, parking, and overlays' },
  { icon: '⌖', label: 'Parcel maps + GIS', detail: 'Boundaries, access, constraints, and surroundings' },
  { icon: '▤', label: 'Title + easements', detail: 'Restrictions, surveys, leases, and property records' },
  { icon: '✦', label: 'Planning notes + research', detail: 'Consultant findings, assumptions, and project files' },
];

const workflow = [
  { icon: '◈', label: 'Utilities + environment', detail: 'Capacity, drainage, and site conditions' },
  { icon: '↗', label: 'Automated AHJ outreach', detail: 'Questions, correspondence, and agency replies', status: 'Outreach active' },
  { icon: '✓', label: 'Permit tracking', detail: 'Milestones, comments, status, and next steps', status: 'Tracking live' },
  { icon: '◫', label: 'Team collaboration', detail: 'Assignments, decisions, markups, and review history', status: 'Shared live' },
];
---

<figure class="cre-project-canvas" aria-label="Illustrative Redflag project workspace connecting site sources to coordination and approvals">
  <div class="cre-project-topbar">
    <div class="cre-project-brand"><span>redflag</span><i aria-hidden="true"></i><b>CRE project workbench</b></div>
  </div>

  <div class="cre-project-stage">
    <div class="cre-project-source-column cre-project-source-column-left">
      <p class="cre-project-side-label"><span>Site + source context</span>What informs the diligence</p>
      {context.map((item) => (
        <article class={`cre-project-source${item.status ? ' has-status' : ''}`}>
          <span class="cre-project-source-icon" aria-hidden="true">{item.icon}</span>
          <div><b>{item.label}</b><span>{item.detail}</span>{item.status && <small class="cre-project-source-status"><i aria-hidden="true"></i>{item.status}</small>}</div>
        </article>
      ))}
    </div>

    <section class="cre-project-hub" aria-label="Redflag CRE project workspace">
      <div class="cre-project-hub-top">
        <div><b>Redflag project workbench</b><span>Connect site context to a coordinated project path</span></div>
        <em><i aria-hidden="true"></i> Team workspace</em>
      </div>

      <div class="cre-project-hub-body">
        <aside class="cre-project-hub-rail" aria-hidden="true"><span class="is-active">⌂</span><span>▤</span><span>⌖</span><span>◫</span><span>◌</span></aside>

        <div class="cre-project-hub-main">
          <div class="cre-project-hub-summary"><span>CONNECTED SITE CONTEXT</span></div>
          <div class="cre-project-map" role="img" aria-label="Diagrammatic parcel map with selected project site">
            <svg viewBox="0 0 320 168" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              <defs><pattern id="cre-workbench-grid" width="22" height="22" patternUnits="userSpaceOnUse"><path d="M 22 0 L 0 0 0 22" fill="none" /></pattern></defs>
              <rect class="cre-project-map-base" width="320" height="168" />
              <rect class="cre-project-map-grid" width="320" height="168" fill="url(#cre-workbench-grid)" />
              <g class="cre-project-map-blocks"><rect x="19" y="19" width="72" height="43" /><rect x="111" y="18" width="87" height="42" /><rect x="218" y="22" width="76" height="43" /><rect x="18" y="93" width="65" height="47" /><rect x="104" y="101" width="95" height="49" /><rect x="228" y="98" width="69" height="42" /></g>
              <path class="cre-project-map-road" d="M-10 76 C64 61 112 89 173 75 S265 61 332 83" />
              <path class="cre-project-map-road cre-project-map-road-secondary" d="M208 -8 C191 48 205 93 190 176" />
              <path class="cre-project-map-boundary" d="M67 35 L171 28 L249 67 L230 130 L128 147 L57 111 Z" />
              <rect class="cre-project-map-parcel" x="141" y="79" width="43" height="35" rx="1" transform="rotate(-7 162.5 96.5)" />
              <circle class="cre-project-map-marker" cx="163" cy="97" r="12" /><path class="cre-project-map-marker-plus" d="M163 91v12M157 97h12" />
            </svg>
          </div>
          <div class="cre-project-hub-cards"><span>Current sources</span><span>Shared team context</span><span>Decision history</span></div>
        </div>

        <aside class="cre-project-work-panel">
          <p>Project workflow</p>
          <div class="cre-project-work-card"><small>Active question</small><a href="#">Can the proposed use proceed by right? ↗</a><mark>Review zoning + title constraints</mark></div>
          <span class="cre-project-action">Open project brief <span aria-hidden="true">↗</span></span>
        </aside>
      </div>
    </section>

    <div class="cre-project-source-column cre-project-source-column-right">
      <p class="cre-project-side-label"><span>Coordination + delivery</span>How teams advance the site</p>
      {workflow.map((item) => (
        <article class={`cre-project-source${item.status ? ' has-status' : ''}`}>
          <span class="cre-project-source-icon" aria-hidden="true">{item.icon}</span>
          <div><b>{item.label}</b><span>{item.detail}</span>{item.status && <small class="cre-project-source-status"><i aria-hidden="true"></i>{item.status}</small>}</div>
        </article>
      ))}
    </div>
  </div>

  <figcaption><div><b>One shared project workspace</b><span>Sources, outreach, approvals, and every decision stay linked - ready for the team to act with context.</span></div></figcaption>
</figure>

<style>
  .cre-project-canvas{background:radial-gradient(circle at 50% 32%,#fff 0%,#f7f9fc 66%,#eef2f7 100%);border:0;border-radius:16px;box-shadow:0 24px 60px rgba(128,88,73,.18),0 6px 18px rgba(83,57,50,.12);display:block;font-family:var(--primary-font);margin:0;overflow:hidden;position:relative;width:100%}
  .cre-project-topbar{align-items:center;background:#1c1f25;color:#fff;display:flex;min-height:64px;padding:15px 22px}.cre-project-brand{align-items:center;display:flex;gap:12px;min-width:0}.cre-project-brand>span{font-family:var(--font-display);font-size:27px;font-weight:700;letter-spacing:-.065em;line-height:1}.cre-project-brand i{background:#687181;height:19px;width:1px}.cre-project-brand b{color:#aeb8c7;font-size:12px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .cre-project-stage{align-items:center;display:grid;gap:clamp(28px,4.4vw,68px);grid-template-columns:minmax(165px,.72fr) minmax(390px,1.65fr) minmax(165px,.72fr);padding:38px 40px 30px;position:relative}.cre-project-source-column{display:grid;gap:13px;min-width:0}.cre-project-side-label{color:#526176;display:grid;font-size:10px;font-weight:600;gap:4px;letter-spacing:.015em;line-height:1.3;margin:0 0 1px}.cre-project-side-label span{color:var(--color-brand-primary);font-size:10px;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.cre-project-source-column-right .cre-project-side-label{text-align:right}.cre-project-source{align-items:center;background:#fff;border:1px solid #dbe3ee;border-radius:12px;box-shadow:0 7px 18px rgba(24,35,59,.06);display:grid;gap:10px;grid-template-columns:34px minmax(0,1fr);min-height:71px;padding:12px;position:relative}.cre-project-source-icon{align-items:center;background:#fff2ef;border-radius:10px;color:var(--color-brand-primary);display:flex;font-size:17px;font-weight:700;height:34px;justify-content:center;line-height:1;width:34px}.cre-project-source div{display:grid;gap:3px;min-width:0}.cre-project-source b{color:var(--cre-ink);font-size:12px;line-height:1.25;overflow-wrap:anywhere}.cre-project-source div span{color:var(--cre-muted);font-size:10px;line-height:1.35;overflow-wrap:anywhere}
  .cre-project-source-column-left .cre-project-source::after,.cre-project-source-column-right .cre-project-source::before{border-top:1px dashed var(--rf-red-400);content:"";opacity:.85;position:absolute;top:50%;width:clamp(30px,3.6vw,54px)}.cre-project-source-column-left .cre-project-source::after{right:calc(clamp(30px,3.6vw,54px) * -1)}.cre-project-source-column-right .cre-project-source::before{left:calc(clamp(30px,3.6vw,54px) * -1)}.cre-project-source-column-left .cre-project-source::before,.cre-project-source-column-right .cre-project-source::after{background:var(--rf-red-400);border:0;border-radius:50%;box-shadow:none;content:"";height:5px;position:absolute;top:calc(50% - 2.5px);width:5px}.cre-project-source-column-left .cre-project-source::before{right:calc(clamp(30px,3.6vw,54px) * -1 - 2.5px)}.cre-project-source-column-right .cre-project-source::after{left:calc(clamp(30px,3.6vw,54px) * -1 - 2.5px)}
  .cre-project-hub{background:#fff;border:1px solid #ffd4cb;border-radius:15px;box-shadow:0 13px 30px rgba(24,35,59,.1);min-width:0;overflow:hidden;position:relative}.cre-project-hub-top,.cre-project-hub-body{position:relative;z-index:1}.cre-project-hub-top{align-items:center;border-bottom:1px solid #dbe3ee;display:flex;gap:12px;justify-content:space-between;padding:13px 15px}.cre-project-hub-top>div{display:grid;gap:3px;min-width:0}.cre-project-hub-top b{font-size:13px;overflow-wrap:anywhere}.cre-project-hub-top span{color:var(--cre-muted);font-size:10px;overflow-wrap:anywhere}.cre-project-hub-top em{align-items:center;background:#e8f7ef;border-radius:999px;color:#19764f;display:flex;font-size:10px;font-style:normal;font-weight:700;gap:6px;padding:7px 9px;white-space:nowrap}.cre-project-hub-top em i{background:#1aa66c;border-radius:50%;height:5px;width:5px}.cre-project-hub-body{display:grid;grid-template-columns:45px minmax(0,1fr) minmax(127px,.62fr);min-height:289px}.cre-project-hub-rail{align-items:center;background:var(--rf-red-600);display:flex;flex-direction:column;gap:7px;padding-top:14px}.cre-project-hub-rail span{align-items:center;border-radius:8px;color:#ffe7e1;display:flex;font-size:14px;height:28px;justify-content:center;width:28px}.cre-project-hub-rail .is-active{background:#fff;color:var(--rf-red-600);box-shadow:0 3px 8px rgba(134,32,14,.2)}.cre-project-hub-main{display:grid;gap:9px;min-width:0;padding:13px}.cre-project-hub-summary{display:grid;gap:2px}.cre-project-hub-summary span{color:#657388;font-size:10px;font-weight:800;letter-spacing:.07em}.cre-project-map{background:var(--rf-red-50);border:1px solid var(--rf-red-100);min-height:142px;overflow:hidden;position:relative}.cre-project-map svg{display:block;height:100%;min-height:142px;width:100%}.cre-project-map-base{fill:#fffaf8}.cre-project-map-grid{stroke:#ffe8e3;stroke-width:1}.cre-project-map-blocks rect{fill:#ffe8e3;stroke:#ffd5cd;stroke-width:1}.cre-project-map-road{fill:none;stroke:#fffdfc;stroke-width:11}.cre-project-map-road-secondary{stroke-width:9}.cre-project-map-boundary{fill:var(--rf-red-400);fill-opacity:.2;stroke:var(--rf-red-600);stroke-dasharray:6 4;stroke-width:2.5}.cre-project-map-parcel{fill:var(--rf-red-500);stroke:var(--rf-red-700);stroke-width:3}.cre-project-map-marker{fill:var(--rf-red-600);stroke:#fffdfc;stroke-width:3}.cre-project-map-marker-plus{fill:none;stroke:#fffdfc;stroke-linecap:round}.cre-project-hub-cards{display:grid;gap:6px;grid-template-columns:repeat(3,minmax(0,1fr))}.cre-project-hub-cards span{background:#f7f9fc;border:1px solid #e1e7ef;color:#657388;font-size:8px;line-height:1.25;padding:6px}
  .cre-project-work-panel{background:var(--rf-red-50);border-left:1px solid var(--rf-red-100);display:flex;flex-direction:column;gap:7px;min-width:0;padding:14px 11px}.cre-project-work-panel>p{color:#a75c51;font-size:9px;font-weight:700;letter-spacing:.07em;text-transform:uppercase}.cre-project-work-card{background:#fff;border:1px solid var(--rf-red-100);border-radius:8px;display:grid;gap:5px;margin-top:4px;padding:8px}.cre-project-work-card small{color:#a75c51;font-size:8px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}.cre-project-work-card a{color:var(--rf-red-600);font-size:10px;font-weight:700;line-height:1.35;overflow-wrap:anywhere;text-decoration:underline;text-underline-offset:2px}.cre-project-work-card mark{background:var(--rf-red-100);color:#7a261c;font-size:9px;line-height:1.35;overflow-wrap:anywhere;padding:3px}.cre-project-action{align-items:center;background:var(--rf-red-600);border:1px solid var(--rf-red-600);border-radius:7px;color:#fff;cursor:pointer;display:inline-flex;font-family:inherit;font-size:10px;font-weight:700;gap:6px;justify-content:center;line-height:1;margin-top:auto;padding:9px 10px}.cre-project-action:hover{background:var(--rf-red-700);border-color:var(--rf-red-700)}
  .cre-project-canvas figcaption{align-items:center;display:flex;justify-content:center;padding:0 28px 31px;position:relative;text-align:center}.cre-project-canvas figcaption div{display:grid;gap:3px}.cre-project-canvas figcaption b{color:var(--cre-ink);font-family:var(--font-display);font-size:19px;letter-spacing:-.03em}.cre-project-canvas figcaption span{color:var(--cre-muted);font-size:12px;line-height:1.4}
  @media(max-width:1040px){.cre-project-stage{gap:24px;grid-template-columns:minmax(150px,.62fr) minmax(380px,1.5fr) minmax(150px,.62fr);padding-inline:24px}.cre-project-source{gap:8px;grid-template-columns:30px minmax(0,1fr);padding:10px}.cre-project-source-icon{height:30px;width:30px}.cre-project-source b{font-size:11px}.cre-project-source div span{font-size:9px}.cre-project-source-column-left .cre-project-source::after,.cre-project-source-column-right .cre-project-source::before{width:24px}.cre-project-source-column-left .cre-project-source::after{right:-24px}.cre-project-source-column-right .cre-project-source::before{left:-24px}.cre-project-source-column-left .cre-project-source::before{right:-26px}.cre-project-source-column-right .cre-project-source::after{left:-26px}}
  @media(max-width:880px){.cre-project-stage{grid-template-columns:repeat(2,minmax(0,1fr));padding:24px}.cre-project-hub{grid-column:1/-1;grid-row:1}.cre-project-source-column{grid-template-columns:repeat(2,minmax(0,1fr))}.cre-project-source-column-left{grid-column:1;grid-row:2}.cre-project-source-column-right{grid-column:2;grid-row:2}.cre-project-side-label{grid-column:1/-1}.cre-project-source-column-left .cre-project-source::after,.cre-project-source-column-right .cre-project-source::before,.cre-project-source-column-left .cre-project-source::before,.cre-project-source-column-right .cre-project-source::after{display:none}}
  @media(max-width:600px){.cre-project-canvas{border-radius:14px;box-shadow:0 18px 44px rgba(128,88,73,.17),0 5px 15px rgba(83,57,50,.1)}.cre-project-topbar{align-items:flex-start;min-height:0;padding:14px 16px}.cre-project-brand{gap:9px}.cre-project-brand>span{font-size:23px}.cre-project-brand b{font-size:10px}.cre-project-stage{display:flex;flex-direction:column;gap:16px;padding:16px}.cre-project-hub{order:1;width:100%}.cre-project-source-column{grid-template-columns:1fr;order:2;width:100%}.cre-project-source{min-height:61px}.cre-project-hub-top{padding:11px}.cre-project-hub-top em{font-size:9px;padding:6px 7px}.cre-project-hub-body{grid-template-columns:35px minmax(0,1fr);min-height:0}.cre-project-hub-rail{gap:4px;padding-top:10px}.cre-project-hub-rail span{font-size:12px;height:24px;width:24px}.cre-project-hub-main{padding:10px}.cre-project-map,.cre-project-map svg{min-height:157px}.cre-project-work-panel{border-left:0;border-top:1px solid var(--rf-red-100);display:grid;gap:6px;grid-column:1/-1;padding:12px}.cre-project-work-panel>p,.cre-project-work-card,.cre-project-action{grid-column:1/-1}.cre-project-work-card{margin-top:0}.cre-project-action{margin-top:0}.cre-project-canvas figcaption{align-items:flex-start;padding:0 16px 22px;text-align:left}.cre-project-canvas figcaption b{font-size:17px}.cre-project-canvas figcaption span{font-size:11px}}

  /* Match the Cities workbench's coral governance state; use green only for live workflow statuses. */
  .cre-project-hub-top em{background:#fff0ed;color:#b63d2b}.cre-project-hub-top em i{background:var(--rf-red-600)}
  .cre-project-source.has-status{min-height:88px}.cre-project-source-status{align-items:center;color:#28714e;display:flex;font-size:8.5px;font-weight:700;gap:5px;line-height:1.25;margin-top:1px}.cre-project-source-status i{background:#74c998;border-radius:50%;box-shadow:0 0 0 3px #e4f6eb;display:block;flex:0 0 5px;height:5px;width:5px}
  @media(max-width:1040px){.cre-project-source.has-status{min-height:86px}.cre-project-source-status{font-size:8px}}
  /* Compact source cards follow their content instead of reserving desktop-height rows. */
  @media(min-width:601px) and (max-width:880px){.cre-project-source-column{grid-template-rows:auto repeat(2,auto)}.cre-project-source,.cre-project-source.has-status{height:auto;min-height:0}}
  @media(max-width:600px){.cre-project-source.has-status{min-height:0}.cre-project-source-status{font-size:8.5px}}
  @media(min-width:461px) and (max-width:700px){.cre-project-stage{display:flex;flex-direction:column;gap:16px;padding:16px}.cre-project-hub{order:1;width:100%}.cre-project-source-column{grid-template-columns:repeat(2,minmax(0,1fr));order:2;width:100%}.cre-project-source,.cre-project-source.has-status{align-items:center;min-height:0}.cre-project-source-column-right .cre-project-side-label{text-align:left}.cre-project-hub-body{grid-template-columns:35px minmax(0,1fr);min-height:0}.cre-project-work-panel{border-left:0;border-top:1px solid var(--rf-red-100);display:grid;gap:6px;grid-column:1/-1;padding:12px}.cre-project-work-panel>p,.cre-project-work-card,.cre-project-action{grid-column:1/-1}.cre-project-work-card,.cre-project-action{margin-top:0}}

  @media(max-width:600px){.cre-project-source-column-right .cre-project-side-label{text-align:left}}
  /* At the intermediate four-card layout, share each row's tallest card across both source groups. */
  @media(min-width:701px) and (max-width:880px){.cre-project-stage{align-items:stretch;column-gap:13px;grid-template-columns:repeat(4,minmax(0,1fr));grid-template-rows:auto auto repeat(2,max-content);row-gap:13px}.cre-project-hub{grid-column:1/-1;grid-row:1;margin-bottom:11px}.cre-project-source-column{display:contents}.cre-project-side-label{align-self:end;grid-row:2;margin:0}.cre-project-source-column-left .cre-project-side-label{grid-column:1/3}.cre-project-source-column-right .cre-project-side-label{grid-column:3/5}.cre-project-source,.cre-project-source.has-status{height:100%;min-height:0}.cre-project-source-column-left .cre-project-source:nth-of-type(1){grid-column:1;grid-row:3}.cre-project-source-column-left .cre-project-source:nth-of-type(2){grid-column:2;grid-row:3}.cre-project-source-column-left .cre-project-source:nth-of-type(3){grid-column:1;grid-row:4}.cre-project-source-column-left .cre-project-source:nth-of-type(4){grid-column:2;grid-row:4}.cre-project-source-column-right .cre-project-source:nth-of-type(1){grid-column:3;grid-row:3}.cre-project-source-column-right .cre-project-source:nth-of-type(2){grid-column:4;grid-row:3}.cre-project-source-column-right .cre-project-source:nth-of-type(3){grid-column:3;grid-row:4}.cre-project-source-column-right .cre-project-source:nth-of-type(4){grid-column:4;grid-row:4}}
  @media(min-width:701px) and (max-width:880px){.cre-project-stage{grid-template-rows:auto auto repeat(2,var(--source-tile-row,max-content))}}

  /* A lifted Redflag screen treatment distinguishes the project workbench without turning brown. */
  .cre-project-hub{--project-hub-ink:#4d2420;--project-hub-muted:#935348;--project-hub-surface:#fff7f5;--project-hub-line:#f4c6bd;--project-hub-accent:#e56754;--project-hub-accent-dark:#c94a38;background:var(--project-hub-surface);border-color:var(--project-hub-line);box-shadow:0 13px 30px rgba(185,65,45,.11)}
  .cre-project-hub-top{background:#fff9f8;border-bottom-color:var(--project-hub-line)}.cre-project-hub-top b{color:var(--project-hub-ink)}.cre-project-hub-top span{color:var(--project-hub-muted)}.cre-project-hub-top em{background:#ffe8e3;color:#bd4d3b}.cre-project-hub-top em i{background:var(--project-hub-accent)}
  .cre-project-hub-body,.cre-project-hub-main{background:var(--project-hub-surface)}.cre-project-hub-rail{background:var(--project-hub-accent)}.cre-project-hub-rail span{color:#fff3f0}.cre-project-hub-rail .is-active{background:#fffafa;color:var(--project-hub-accent-dark);box-shadow:0 3px 8px rgba(186,60,40,.15)}.cre-project-hub-summary span{color:#b65c4d}
  .cre-project-map{background:#ffede8;border-color:#f1c8bf}.cre-project-map-base{fill:#fff8f6}.cre-project-map-grid{stroke:#f9d8d1}.cre-project-map-blocks rect{fill:#f7ded7;stroke:#efc7bd}.cre-project-map-road{stroke:#fffdfc}.cre-project-map-boundary{fill:#e68473;fill-opacity:.25;stroke:#df5d49}.cre-project-map-parcel{fill:#e5654f;stroke:#bd4332}.cre-project-map-marker{fill:#e4543c;stroke:#fffdfc}.cre-project-map-marker-plus{stroke:#fffdfc}
  .cre-project-hub-cards span{background:#fff0ec;border-color:#f4cdc4;color:#8e4a40}.cre-project-work-panel{background:#fff0ed;border-left-color:#f2cac1}.cre-project-work-panel>p,.cre-project-work-card small{color:#b55a4b}.cre-project-work-card{background:#fff9f7;border-color:#f2cbc3}.cre-project-work-card a{color:#bf4433}.cre-project-work-card mark{background:#f9d2c8;color:#752a1f}.cre-project-action{background:#dc5844;border-color:#dc5844}.cre-project-action:hover{background:#c84936;border-color:#c84936}

  /* Product canvases use a restrained four-step text scale, separate from page typography. */
  .cre-project-canvas{--canvas-text-strong:var(--rf-canvas-text-strong);--canvas-text:var(--rf-canvas-text);--canvas-text-muted:var(--rf-canvas-text-muted);--canvas-text-faint:var(--rf-canvas-text-faint);--cre-ink:var(--canvas-text-strong);--cre-muted:var(--canvas-text-muted);color:var(--canvas-text)}
  .cre-project-side-label{color:var(--canvas-text)}
  .cre-project-hub{--project-hub-ink:var(--rf-red-600);--project-hub-muted:var(--rf-red-600)}
  .cre-project-hub-summary span,.cre-project-hub-cards span{color:var(--rf-red-600)}
  .cre-project-work-panel>p,.cre-project-work-card small,.cre-project-work-card a,.cre-project-work-card mark{color:var(--rf-red-600)}
  .cre-project-action{cursor:default}.cre-project-action:hover{background:#dc5844;border-color:#dc5844}
</style>

<script>
  const sourceStage = document.querySelector('.cre-project-stage');

  if (sourceStage) {
    const sourceTileRange = window.matchMedia('(min-width: 701px) and (max-width: 880px)');
    const syncSourceTileHeight = () => {
      sourceStage.style.removeProperty('--source-tile-row');
      if (!sourceTileRange.matches) return;

      const cards = Array.from(sourceStage.querySelectorAll('.cre-project-source'));
      const tallest = Math.ceil(Math.max(...cards.map((card) => card.getBoundingClientRect().height)));
      sourceStage.style.setProperty('--source-tile-row', `${tallest}px`);
    };
    const scheduleSourceTileSync = () => requestAnimationFrame(syncSourceTileHeight);

    window.addEventListener('resize', scheduleSourceTileSync);
    sourceTileRange.addEventListener?.('change', scheduleSourceTileSync);
    document.fonts?.ready.then(scheduleSourceTileSync);
    scheduleSourceTileSync();
  }
</script>
