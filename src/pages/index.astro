---
import Layout from '../layouts/Layout.astro';
import CREHero from '../components/CREHero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import SplitSection from '../components/SplitSection.astro';
import CTA from '../components/CTA.astro';
import CREReviewWorkspace from '../components/CREReviewWorkspace.astro';
import CREValueOutcomes from '../components/CREValueOutcomes.astro';
import CRESCoverage from '../components/CRESCoverage.astro';
import CREAnswerCards from '../components/CREAnswerCards.astro';
import { cre as content } from '../content/cre';
---
<Layout page={content}><main class={`${content.mainClass} cre-page`}><CREHero /><SplitSection markup={content.sections[1]} /><CREAnswerCards /><CRESCoverage /><CREReviewWorkspace /><CREValueOutcomes /><SplitSection markup={content.sections[6]} /><FeatureGrid markup={content.sections[7]} /><CTA markup={content.sections[8]} /></main></Layout>
