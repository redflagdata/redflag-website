---
const { content } = Astro.props;
---

<section class="band government-capabilities">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">{content.eyebrow}</p>
      <h2>{content.title}</h2>
    </div>
    <div class="capability-grid">
      {content.items.map((item: { title: string; text: string }) => (
        <article class="capability">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
