---
import ArrowUpRight from './ArrowUpRight.astro';
import CheckIcon from './CheckIcon.astro';

const citations = [
  {
    id: 'zoning',
    number: '1',
    label: 'B-3 monument sign standards',
    source: 'Code of Ordinances · B-3 signage',
    page: 'Chapter 18.7',
    title: 'B-3 monument sign standards',
    section: 'Code of Ordinances · Signs + site identity',
    excerpt: 'The B-3 district permits one freestanding monument sign for each public street frontage. Monument signs are limited to 8 feet measured above adjacent grade and a sign face of no more than 48 square feet.',
    highlight: 'A monument sign may not be located within the required sight triangle, a public utility easement, or the required front setback unless specifically authorized.',
    application: 'The Main Street frontage supports a single monument sign; the submitted location must be confirmed against the sight triangle, setback, and recorded utility information.',
    relatedHeading: 'Zoning check completed',
    related: 'The proposed sign use, overall height, and face area meet district limits; its final location remains a site-plan coordination item.',
  },
  {
    id: 'project',
    number: '2',
    label: 'Submitted signage plan',
    source: 'Project files · A0.2 / S1.0',
    page: 'Signage set · A0.2 / S1.0',
    title: 'Proposed monument sign',
    section: 'Illustrative project information · Signage review',
    excerpt: 'The submitted signage set identifies one double-faced monument sign along Main Street. The sign is shown at 6 feet overall with a 32-square-foot copy area, set behind the sidewalk and outside the driveway throat.',
    highlight: 'The plan depicts one freestanding sign on the property’s only public street frontage; no second freestanding sign or electronic message center is shown.',
    application: 'The plan facts fit the district allowance. Moving the sign, enlarging its face, or adding a digital display should trigger a refreshed review against the applicable standard.',
    relatedHeading: 'Project facts used in the answer',
    related: 'The location, copy area, overall height, frontage count, and display type are the project-specific facts that establish a reliable signage finding.',
  },
  {
    id: 'definitions',
    number: '3',
    label: 'Sign area + height measurement',
    source: 'Code of Ordinances · Sign definitions',
    page: 'Chapter 18.1',
    title: 'Sign measurement definitions',
    section: 'Code of Ordinances · Definitions',
    excerpt: 'Sign face area is measured as the smallest geometric shape enclosing the copy, logo, border, and supporting frame visible on one face. Overall sign height is measured from adjacent finished grade to the top of the sign.',
    highlight: 'Decorative cap features and integral sign framing count toward overall height; the base is excluded from sign area only when it carries no copy.',
    application: 'The stated 32-square-foot copy area and 6-foot height should be reconfirmed from the permitted sign elevation and final grading, not an unscaled rendering.',
    relatedHeading: 'Measurement check to carry forward',
    related: 'Show dimensions for both faces, top of sign, adjacent grade, and copy area so the final construction set can be verified.',
  },
  {
    id: 'building',
    number: '4',
    label: 'Structural + electrical sign permits',
    source: 'Building Code · Structural + electrical',
    page: 'Building Code §3107',
    title: 'Freestanding sign construction requirements',
    section: 'Building Code · Sign supports + electrical',
    excerpt: 'Freestanding signs must be designed for applicable wind loads and supported by foundations sized for the site soils. Electrical components must be permitted and listed for the intended installation.',
    highlight: 'The permit application must include structural support and foundation information, electrical details, and site placement coordinated with underground utilities.',
    application: 'Zoning allows the sign in principle; building and electrical permit materials must establish a safe foundation and installation before field work begins.',
    relatedHeading: 'Permit set to prepare',
    related: 'Request signed structural and electrical details, footing depth, and utility locates with the final monument sign permit package.',
  },
];

const comments = [
  {
    id: 'chase',
    initials: 'CT',
    name: 'Chris T.',
    date: 'January 1, 2025',
    citation: 'zoning',
    text: 'Please confirm that the monument sign remains outside the Main Street sight triangle and recorded utility easement before we issue the site brief.',
    status: 'Assigned to Jason',
  },
  {
    id: 'matt',
    initials: 'CT',
    name: 'Chris T.',
    date: 'January 1, 2025',
    citation: 'building',
    text: 'Please add the signed footing and electrical details to the permit set before the signage package is released.',
    status: 'Assigned to Matt',
  },
];
---

<section class="split-section-examples cre-workspace-section">
  <main class="width-wrapper width-wrapper-full-width">
    <div class="header-wrapper">
      <h1 class="feature-heading">Decision intelligence.</h1>
      <h1 class="section-subtitle">Edit, comment, and make decisions visible to every team.</h1>
    </div>

    <section class="cre-review-workspace" data-cre-review-workspace data-active-citation="zoning" aria-label="Illustrative collaborative site review workspace">
      <header class="cre-review-topbar">
        <span class="cre-review-wordmark">redflag</span>
        <div class="cre-review-tools" aria-hidden="true">
          <span class="cre-icon-button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14v10H9l-4 4V5Z"/><path d="m7 7 10 6M17 7 7 13"/></svg></span>
          <span class="cre-icon-button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19"/><circle cx="7" cy="7" r="2"/><circle cx="17" cy="17" r="2"/></svg></span>
          <span class="cre-icon-button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l3 3v15H6z"/><path d="M14 3v4h4M9 12h6M9 16h6"/></svg></span>
          <span class="cre-tool-divider" aria-hidden="true"></span>
          <span class="cre-icon-button"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3.5 19c.8-3.1 2.8-4.7 5.5-4.7s4.7 1.6 5.5 4.7M17 9v6M14 12h6"/></svg></span>
          <div class="cre-review-tools__primary">
            <span class="cre-share-button">Share</span>
            <span class="cre-icon-button cre-close-button">×</span>
            <span class="cre-person-button"><span class="cre-person-avatar">CT</span></span>
          </div>
        </div>
      </header>

      <div class="cre-review-main">
        <section class="cre-review-stage" aria-label="Project analysis">
          <div class="cre-review-question">
            <div class="cre-review-question-heading">
              <span>Answers</span>
              <em>Due diligence phase</em>
            </div>
            <h2>Is a monument sign allowed for the proposed retail site?</h2>
          </div>

          <div class="cre-review-answer">
            <p><span class="cre-review-answer-check"><CheckIcon /></span><strong>Answer:</strong><span class="cre-answer-copy">Yes—the proposed single monument sign is allowed on the Main Street frontage. Its 6-foot overall height and 32-square-foot sign face are within the B-3 district’s 8-foot and 48-square-foot limits <button type="button" class="cre-inline-citation" data-citation-target="zoning">1</button>, <button type="button" class="cre-inline-citation" data-citation-target="project">2</button>, <button type="button" class="cre-inline-citation" data-citation-target="definitions">3</button>.</span></p>
            <div class="cre-review-factors">
              <b>Key Factors for Review:</b>
              <ul>
                <li><span class="cre-factor-checkbox" aria-hidden="true"></span><span class="cre-factor-copy"><b>Location + frontage:</b> Keep the sign outside the sight triangle, utility easements, and required front setback. One monument sign is allowed for the Main Street frontage <button type="button" class="cre-inline-citation" data-citation-target="zoning">1</button> <button type="button" class="cre-inline-citation" data-citation-target="project">2</button>.</span></li>
                <li><span class="cre-factor-checkbox" aria-hidden="true"></span><span class="cre-factor-copy"><b>Measurement:</b> Verify the 32-square-foot copy area and 6-foot height from final grade. The cap, frame, and any copy on the base can change the measured result <button type="button" class="cre-inline-citation" data-citation-target="project">2</button> <button type="button" class="cre-inline-citation" data-citation-target="definitions">3</button>.</span></li>
                <li><span class="cre-factor-checkbox" aria-hidden="true"></span><span class="cre-factor-copy"><b>Construction permit:</b> Provide signed footing and wind-load details, electrical information, and utility coordination before installation <button type="button" class="cre-inline-citation" data-citation-target="building">4</button>.</span></li>
              </ul>
            </div>
          </div>

          <div class="cre-review-evidence">
            <aside class="cre-citation-panel" aria-label="Citations">
              <div class="cre-panel-heading"><b>Citations</b><span>4 linked</span></div>
              <div class="cre-citation-list">
                {citations.map((citation, index) => (
                  <button type="button" class={`cre-citation-item${index === 0 ? ' is-active' : ''}`} data-citation-target={citation.id} aria-pressed={index === 0 ? 'true' : 'false'}>
                    <span>{citation.number}</span>
                    <div><b>{citation.label}</b><small>{citation.source}</small></div>
                    <i aria-hidden="true">›</i>
                  </button>
                ))}
              </div>
            </aside>

            <section class="cre-document-panel" aria-label="Selected citation detail">
              <div class="cre-document-toolbar">
                <label><span class="visually-hidden">Search in document</span><input type="search" placeholder="Search in document..." /></label>
                <div aria-hidden="true"><span>0 / 0</span><i>↑</i><i>↓</i><ArrowUpRight /><i>⋮</i></div>
              </div>
              <div class="cre-document-scroll" tabindex="0" aria-label="Scrollable cited document">
                {citations.map((citation, index) => (
                  <article class={`cre-document-page${index === 0 ? ' is-active' : ''}`} data-citation-detail={citation.id}>
                    <p class="cre-document-kicker">{citation.page}</p>
                    <h3>{citation.title}</h3>
                    <p class="cre-document-section">{citation.section}</p>
                    <p>{citation.excerpt}</p>
                    <p class="cre-document-highlight">{citation.highlight}</p>
                    <p>{citation.application}</p>
                    <h4>{citation.relatedHeading}</h4>
                    <p>{citation.related}</p>
                    <p class="cre-document-highlight">This illustrative source window stays independently scrollable so the cited passage remains available while the team reviews the answer.</p>
                    <p>Supporting correspondence, plan revisions, and subsequent decisions remain associated with this review record.</p>
                  </article>
                ))}
              </div>
            </section>
          </div>
        </section>

        <aside class="cre-comments-panel" aria-label="Review comments">
          <div class="cre-comments-heading"><div><span>Review comments</span><b>2 active threads</b></div><button type="button" class="cre-icon-button" aria-label="Add a comment">+</button></div>
          <div class="cre-comment-list">
            {comments.map((comment, index) => (
              <article class={`cre-comment-card${index === 0 ? ' is-active' : ''}`} data-comment-card={comment.id} data-comment-citation={comment.citation} tabindex="0">
                <div class="cre-comment-meta"><i>{comment.initials}</i><div><b>{comment.name}</b><span>{comment.date}</span></div><button type="button" aria-label={`More options for ${comment.name}`}>⋮</button></div>
                <p>{comment.text}</p>
                {index === 1 && <div class="cre-file-attachment"><span>PDF</span><div><b>monument_sign<br/>markup.PDF</b><small>2.4 MB</small></div></div>}
                <div class="cre-comment-footer"><span>◉ {comment.status}</span></div>
              </article>
            ))}
          </div>
        </aside>
      </div>
    </section>

    <div class="cre-workspace-captions" aria-label="Workspace capabilities">
      <article><h3>Answers you can trust</h3><p>Clear reasoning and key factors, explained.</p><p>Jump to any source, with relevant text highlighted.</p></article>
      <article><h3>Edit and Collaborate</h3><p>Share with collaborators, add comments and attachments.</p><p>Never forget who made a decision or why (Email from a planner? Variance granted? Saved!)</p></article>
      <article><h3>Bring your own data</h3><p>Bring titles, easements, plan amendments, CC&amp;Rs, leases, and other project records into the review.</p><p>Keep source changes connected to the decisions and context they affect.</p></article>
    </div>
  </main>
</section>

<script>
  const workspace = document.querySelector<HTMLElement>('[data-cre-review-workspace]');

  if (workspace) {
    const citationControls = [...workspace.querySelectorAll<HTMLButtonElement>('[data-citation-target]')];
    const citationItems = [...workspace.querySelectorAll<HTMLButtonElement>('.cre-citation-item')];
    const documents = [...workspace.querySelectorAll<HTMLElement>('[data-citation-detail]')];
    const documentScroll = workspace.querySelector<HTMLElement>('.cre-document-scroll');
    const comments = [...workspace.querySelectorAll<HTMLElement>('[data-comment-card]')];

    const setCitation = (citationId: string) => {
      workspace.dataset.activeCitation = citationId;
      citationItems.forEach((item) => {
        const isActive = item.dataset.citationTarget === citationId;
        item.classList.toggle('is-active', isActive);
        item.setAttribute('aria-pressed', String(isActive));
      });
      citationControls.forEach((item) => item.classList.toggle('is-active', item.dataset.citationTarget === citationId));
      documents.forEach((item) => item.classList.toggle('is-active', item.dataset.citationDetail === citationId));
      if (documentScroll) documentScroll.scrollTop = 0;
    };

    citationControls.forEach((control) => control.addEventListener('click', () => {
      const citationId = control.dataset.citationTarget;
      if (citationId) setCitation(citationId);
    }));

    comments.forEach((comment) => {
      const setComment = () => {
        comments.forEach((item) => item.classList.toggle('is-active', item === comment));
        const citationId = comment.dataset.commentCitation;
        if (citationId) setCitation(citationId);
      };
      comment.addEventListener('click', setComment);
      comment.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); setComment(); }
      });
    });

  }
</script>

<style>
  .cre-workspace-section{background:linear-gradient(180deg,#fffdfb 0%,var(--cre-warm-deep) 100%);padding:clamp(82px,9vw,128px) 24px}
  .cre-workspace-section .header-wrapper{align-items:center;display:flex;flex-direction:column;gap:14px;margin:0 auto 48px;max-width:810px;text-align:center}
  .cre-workspace-section .feature-heading{color:var(--cre-ink);font-family:var(--font-display);font-size:clamp(32px,4vw,52px);font-weight:720;letter-spacing:-.045em;line-height:1.05;margin:0}
  .cre-workspace-section .section-subtitle{color:var(--cre-muted);font-family:var(--primary-font);font-size:clamp(17px,1.65vw,20px);font-weight:400;line-height:1.58;margin:0;max-width:720px}

  .cre-review-workspace{background:var(--rf-surface-50);border:0;border-radius:16px;box-shadow:0 24px 60px rgba(128,88,73,.18),0 6px 18px rgba(83,57,50,.12);color:var(--cre-ink);font-family:var(--primary-font);margin:0 auto;max-width:1200px;overflow:hidden}
  .cre-review-topbar{align-items:center;background:#1d1d20;color:#fff;display:flex;flex:0 0 auto;isolation:isolate;justify-content:space-between;min-height:58px;padding:10px 16px 10px 22px;position:relative;z-index:2}
  .cre-review-wordmark{color:#fff;font-family:var(--font-display);font-size:28px;font-weight:720;letter-spacing:-.06em;line-height:1;text-decoration:none}
  .cre-review-tools{align-items:center;display:flex;gap:8px}
  .cre-review-tools__primary{align-items:center;display:flex;gap:8px}
  .cre-icon-button,.cre-person-button,.cre-share-button{align-items:center;background:transparent;border:0;color:#d7dbe2;cursor:pointer;display:inline-flex;font-family:var(--primary-font);justify-content:center}
  .cre-icon-button{border-radius:6px;height:30px;padding:6px;width:30px}
  .cre-icon-button:hover,.cre-icon-button:focus-visible{background:#34343a;color:#fff;outline:0}
  .cre-icon-button svg{fill:none;height:18px;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.7;width:18px}
  .cre-tool-divider{background:#56565d;height:20px;margin:0 3px;width:1px}
  .cre-share-button{background:var(--color-brand-primary);border-radius:6px;color:#fff;font-size:12px;font-weight:700;height:31px;padding:0 14px}
  .cre-share-button:hover{background:var(--color-brand-primary-hover)}
  .cre-close-button{background:#606168;color:#fff;font-size:22px;line-height:1}
  .cre-person-button{height:30px;padding:0;width:30px}
  .cre-person-avatar{align-items:center;background:#5d54b7;border-radius:50%;color:#fff;display:inline-flex;font-size:10px;font-weight:700;height:29px;justify-content:center;width:29px}
  .cre-review-topbar .cre-icon-button,.cre-review-topbar .cre-person-button,.cre-review-topbar .cre-share-button{cursor:default;pointer-events:none}
  .cre-review-topbar .cre-icon-button:hover{background:transparent;color:#d7dbe2}.cre-review-topbar .cre-share-button:hover{background:var(--color-brand-primary)}

  .cre-review-main{display:grid;grid-template-columns:minmax(0,1fr) 246px;height:650px;min-height:0}
  .cre-review-stage{display:grid;grid-template-rows:auto auto minmax(0,1fr);min-height:0;min-width:0}
  .cre-review-question{border-bottom:1px solid var(--cre-line);min-width:0;padding:18px 22px 14px}
  .cre-review-question-heading{align-items:center;color:var(--cre-muted);display:flex;font-size:10px;font-weight:700;justify-content:space-between;letter-spacing:.09em;text-transform:uppercase}
  .cre-review-question-heading em{background:var(--rf-red-50);border-radius:999px;color:var(--rf-red-700);font-size:10px;font-style:normal;letter-spacing:0;padding:5px 8px;text-transform:none}
  .cre-review-question h2{color:var(--cre-ink);font-family:var(--primary-font);font-size:20px;letter-spacing:-.025em;line-height:1.2;margin:7px 0 0}
  .cre-review-answer{border-bottom:1px solid var(--cre-line);min-width:0;padding:14px 22px 16px}
  .cre-review-answer>p{align-items:flex-start;color:var(--cre-ink);display:flex;font-size:14px;gap:6px;line-height:1.5;margin:0}
  .cre-review-answer-check{--rf-check-icon-size:11px;align-items:center;background:#e7f6ef;border-radius:50%;color:#14835c;display:inline-flex;flex:0 0 22px;height:22px;justify-content:center;width:22px}.cre-review-answer>p>strong{flex:0 0 auto}.cre-answer-copy{display:block;flex:1 1 auto;min-width:0}
  .cre-review-factors{border-left:2px solid var(--cre-line);display:grid;gap:8px;margin:14px 0 0 10px;padding-left:15px}
  .cre-review-factors>b{font-size:12px}.cre-review-factors ul{display:grid;gap:7px;list-style:none;margin:0;padding:0}
  .cre-review-factors li{align-items:flex-start;color:var(--cre-muted);display:flex;font-size:12px;gap:8px;line-height:1.45}
  .cre-review-factors li>.cre-factor-checkbox{align-self:flex-start;aspect-ratio:1 / 1;border:1px solid #c9d2dc;border-radius:3px;box-sizing:border-box;flex:0 0 12px;height:12px;margin-top:2px;max-width:12px;min-height:12px;min-width:12px;width:12px}.cre-factor-copy{display:block;min-width:0}.cre-factor-copy b{color:var(--cre-ink)}
  .cre-inline-citation{background:transparent;border:0;color:var(--color-brand-primary);cursor:pointer;font-family:inherit;font-size:inherit;font-weight:700;line-height:1;padding:0}
  .cre-inline-citation:hover,.cre-inline-citation.is-active{color:var(--rf-blue-700);text-decoration:underline}

  .cre-review-evidence{display:grid;grid-template-columns:240px minmax(0,1fr);min-height:0;min-width:0}
  .cre-citation-panel{background:var(--rf-surface-50);border-right:1px solid var(--cre-line);min-height:0;min-width:0;overflow-y:auto;overscroll-behavior-y:auto;padding:15px 12px}
  .cre-citation-panel::-webkit-scrollbar,.cre-document-scroll::-webkit-scrollbar,.cre-comment-list::-webkit-scrollbar{width:var(--rf-canvas-scrollbar-size)}
  .cre-citation-panel::-webkit-scrollbar-track,.cre-document-scroll::-webkit-scrollbar-track,.cre-comment-list::-webkit-scrollbar-track{background:transparent;margin:var(--rf-canvas-scrollbar-inset) 0}
  .cre-citation-panel::-webkit-scrollbar-thumb,.cre-document-scroll::-webkit-scrollbar-thumb,.cre-comment-list::-webkit-scrollbar-thumb{background:var(--rf-canvas-scrollbar-thumb);background-clip:padding-box;border:1px solid transparent;border-radius:999px}
  .cre-panel-heading{align-items:center;display:flex;justify-content:space-between;margin:0 3px 10px}.cre-panel-heading b{font-size:14px}.cre-panel-heading span{color:var(--cre-muted);font-size:10px}
  .cre-citation-list{display:grid;gap:7px}
  .cre-citation-item{align-items:center;background:#fff;border:1px solid var(--cre-line);border-radius:8px;color:var(--cre-ink);cursor:pointer;display:grid;gap:9px;grid-template-columns:24px minmax(0,1fr) 12px;min-width:0;padding:9px;text-align:left;transition:border-color .18s,box-shadow .18s,transform .18s}
  .cre-citation-item:hover{border-color:#a9b7c8;box-shadow:0 3px 12px rgba(17,24,39,.06);transform:translateY(-1px)}
  .cre-citation-item.is-active{background:var(--rf-blue-50);border-color:var(--rf-blue-600);box-shadow:0 3px 12px rgba(49,87,246,.12)}
  .cre-citation-item>span{align-items:center;background:var(--rf-surface-100);border:1px solid var(--cre-line);border-radius:50%;display:flex;font-size:12px;font-weight:700;height:24px;justify-content:center;width:24px}
  .cre-citation-item.is-active>span{background:#fff;border-color:var(--rf-blue-600);color:var(--rf-blue-700)}
  .cre-citation-item div{display:grid;gap:3px;min-width:0}.cre-citation-item b{font-size:11px;line-height:1.25}.cre-citation-item small{color:var(--cre-muted);font-size:9px;line-height:1.3}.cre-citation-item>i{color:var(--cre-muted);font-size:23px;font-style:normal;line-height:1}
  .cre-document-panel{background:var(--rf-surface-100);display:grid;grid-template-rows:44px minmax(0,1fr);min-height:0;min-width:0}
  .cre-document-toolbar{align-items:center;background:#fff;border-bottom:1px solid var(--cre-line);display:flex;gap:10px;justify-content:space-between;padding:7px 12px}.cre-document-toolbar label{min-width:0}
  .cre-document-toolbar input{background:#fff;border:1px solid var(--cre-line);border-radius:5px;color:var(--cre-ink);font-family:var(--primary-font);font-size:11px;min-width:0;outline:0;padding:7px 9px;width:185px}
  .cre-document-toolbar input:focus{border-color:var(--rf-blue-600);box-shadow:0 0 0 3px rgba(49,87,246,.12)}
  .cre-document-toolbar>div{align-items:center;color:var(--cre-muted);display:flex;font-size:13px;gap:11px}.cre-document-toolbar>div span{font-size:11px;font-weight:700}.cre-document-toolbar i{font-style:normal}
  .cre-document-scroll{min-height:0;overflow-y:auto;overscroll-behavior-y:auto;padding:14px}
  .cre-document-page{background:#fff;box-shadow:0 1px 4px rgba(17,24,39,.12);color:#464145;display:none;font-family:Georgia,serif;gap:13px;min-height:530px;padding:25px 24px}.cre-document-page.is-active{display:grid}
