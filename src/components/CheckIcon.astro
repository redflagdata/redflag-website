---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class:list={['rf-check-icon', className]} viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
  <path d="m4.5 10.2 3.4 3.5 7.7-8" />
</svg>

<style is:global>
  .rf-check-icon {
    display: block;
    height: var(--rf-check-icon-size, 1em);
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.25;
    width: var(--rf-check-icon-size, 1em);
  }
</style>
