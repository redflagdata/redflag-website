      </svg>
      <div class="viewer-parcel-card"><span>Selected parcel</span><b>Parcel 092-174-210</b><small>10.4 ac - B-3 Commercial</small></div>
    </section>

    <section class="viewer-documents" aria-label="Selected regulation document viewer">
      <div class="viewer-documents-heading"><div><span>Document viewer</span><b>Selected source</b></div></div>
      <div class="viewer-document-scroll" aria-live="polite">
        {records.map((record, index) => (
          <article class={`viewer-document${index === 0 ? ' is-active' : ''}`} data-source-record={record.id} tabindex="0">
            <div class="viewer-document-type">{record.type}<span>{record.scope}</span></div>
            <h3>{record.source}</h3>
            <div class="viewer-pdf-frame" aria-label={`Illustrative document viewer for ${record.source}`}>
              <div class="viewer-pdf-toolbar"><span>{record.page}</span><div aria-hidden="true"><i>⌕</i><i>↑</i><i>↓</i><i>↗</i></div></div>
              <div class="viewer-pdf-window" tabindex="0" aria-label={`${record.source} document excerpt`}>
                <article class="viewer-pdf-page">
                  <p class="viewer-pdf-kicker">Illustrative regulation excerpt</p>
                  <h4>{record.documentTitle}</h4>
                  <p class="viewer-pdf-section">{record.documentSection}</p>
                  <p>{record.documentLead}</p>
                  <p class="viewer-pdf-highlight">{record.documentHighlight}</p>
                  <h5>{record.documentNext}</h5>
                  <p>{record.documentTail}</p>
                  <p>Staff can keep this source, the linked boundary, and the project record together when preparing a response.</p>
                </article>
                <article class="viewer-pdf-page viewer-pdf-page-continuation">
                  <p class="viewer-pdf-kicker">Continued</p>
                  <h4>Review notes and cross-references</h4>
                  <p>This illustrative page represents the surrounding context a reviewer can inspect without leaving the project workspace.</p>
                  <p class="viewer-pdf-highlight">Mapped extent is shown alongside the selected parcel so staff can distinguish citywide standards from plan areas and partial overlays.</p>
                  <p>Related records, prior interpretations, and final correspondence remain attached to the reviewed source.</p>
                </article>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</div>

<script>
  const viewer = document.querySelector<HTMLElement>('[data-city-source-viewer]');
  if (viewer) {
    const records = [...viewer.querySelectorAll<HTMLElement>('[data-source-record]')];
    const controls = [...viewer.querySelectorAll<HTMLButtonElement>('[data-source-target]')];
    const overlays = [...viewer.querySelectorAll<HTMLElement>('[data-map-overlay]')];
    const sourceName = viewer.querySelector<HTMLElement>('[data-active-source-name]');

    const setActive = (sourceId: string) => {
      const record = records.find((item) => item.dataset.sourceRecord === sourceId);
      if (!record) return;
      viewer.dataset.activeSource = sourceId;
      records.forEach((item) => item.classList.toggle('is-active', item === record));
      controls.forEach((item) => {
        const isActive = item.dataset.sourceTarget === sourceId;
        item.classList.toggle('is-active', isActive);
        item.setAttribute('aria-pressed', String(isActive));
      });
      overlays.forEach((item) => item.classList.toggle('is-active', item.dataset.mapOverlay === sourceId));
      if (sourceName) sourceName.textContent = record.querySelector('h3')?.textContent || '';
    };

    controls.forEach((control) => control.addEventListener('click', () => {
      const sourceId = control.dataset.sourceTarget;
      if (sourceId) setActive(sourceId);
    }));
    records.forEach((record) => {
      record.addEventListener('click', () => setActive(record.dataset.sourceRecord || ''));
      record.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); setActive(record.dataset.sourceRecord || ''); }
      });
    });
  }
</script>

